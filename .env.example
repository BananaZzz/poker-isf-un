# ---------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) for local development, and set the
# same variables in Render → Environment for production. Never commit real
# secrets to version control.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev options:
#   - Neon free tier (recommended, zero setup): copy the pooled connection URL
#     from https://console.neon.tech → your project → Connection details.
#   - A locally running Postgres: postgresql://postgres:postgres@localhost:5432/poker
# In production, Render reads this variable from the service's Environment tab.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Random string used to sign / rotate session cookies.
# Generate one with:  openssl rand -hex 32
# On Render, render.yaml declares `generateValue: true` so Render creates a
# strong random value on first deploy — you do NOT paste this one in prod.
SESSION_SECRET="change-me-in-production-to-a-long-random-string"

# Standard Node environment flag. Render sets this via render.yaml.
NODE_ENV="development"

# Optional: port for local `npm run start`. `npm run dev` uses 3000 by default.
# In production Render injects PORT automatically — you do NOT set it manually.
# PORT=3000
