# SQLite file lives beside prisma/. For Postgres, change provider in prisma/schema.prisma and set:
# DATABASE_URL="postgresql://user:pass@localhost:5432/poker"
DATABASE_URL="file:./dev.db"

# Cookie signing secret — change in production
SESSION_SECRET="change-me-in-production-to-a-long-random-string"

# Port
PORT=3000
